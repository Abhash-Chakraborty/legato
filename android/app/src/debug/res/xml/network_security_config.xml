<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: plain HTTP too, so a test update can come from a
     machine on the local network (the `update_manifest` pref). Release
     builds keep the HTTPS-only config in main. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
