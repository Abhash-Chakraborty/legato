<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Keeps the CPU up while a recording is written up with the screen off. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Bluetooth to the PC when they share no network. -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Installing an update downloaded from GitHub Releases (you confirm it). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Names the app a dictation went into (Chrome, WhatsApp) in Home. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".LegatoApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:networkSecurityConfig="@xml/network_security_config"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Legato">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- A pairing link opened from another app lands here, and is
                 shown for you to confirm. Not BROWSABLE: a web page can't
                 start pairing. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="legato" android:host="pair" />
            </intent-filter>
        </activity>

        <!-- "Send to PC" in the share menu and on selected text. -->
        <activity
            android:name=".SendToPcActivity"
            android:exported="true"
            android:label="@string/send_to_pc"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@style/Theme.Legato.Send">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- Reads a copy made in another app, unseen, for the shared clipboard. -->
        <activity
            android:name=".ClipReadActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Legato.Clip" />

        <!-- "Transform" on selected text: one of the PC's transforms rewrites it. -->
        <activity
            android:name=".TransformActivity"
            android:exported="true"
            android:label="@string/transform"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.Legato.Send">
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- Sees the keyboard open and types the text into the field; shows the bubble. -->
        <service
            android:name=".bubble.BubbleAccessibilityService"
            android:exported="true"
            android:label="@string/accessibility_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility" />
        </service>

        <!-- Holds the microphone while you talk; Android wants a foreground service for that. -->
        <service
            android:name=".bubble.DictationService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- Records a voice memo from the Notes tab, screen off or not. -->
        <service
            android:name=".MemoService"
            android:exported="false"
            android:foregroundServiceType="microphone" />
        <!-- Hands a downloaded update to Android's installer. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/update_paths" />
        </provider>
    </application>
</manifest>
